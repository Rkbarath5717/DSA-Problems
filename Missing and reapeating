class Solution {
    ArrayList<Integer> findTwoElement(int arr[]) {
        int count[]=new int[arr.length+1];
        for(int i=0;i<arr.length;i++){
            count[arr[i]]++;
        }
        int missing = 0;
        int repeating = 0;
        for(int i=1;i<=arr.length;i++){
            if(count[i] == 2){
                repeating = i;
            }
            if(count[i]==0){
                missing = i;
            }
        }
        ArrayList<Integer> list = new ArrayList<>();
        list.add(repeating);
        list.add(missing);
        
        return list;
    }
}
