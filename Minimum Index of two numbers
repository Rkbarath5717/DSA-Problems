class Solution {
    int minDist(int arr[], int x, int y) {
        int n = arr.length;
        int first=-1;
        int last = -1;
        int min = Integer.MAX_VALUE;
        for(int i=0;i<n;i++){
            if(arr[i]==x){
                first=i;
            }
            if(arr[i]==y){
                last=i;
            }
            if(first != -1 && last !=-1){
                int distance = Math.abs(first-last);
                if(distance < min){
                    min=distance;
                }
            }
        }
        if(min == Integer.MAX_VALUE){
            return -1;
        }
        return min;
    }
}
