class Solution {
    void rearrange(ArrayList<Integer> arr) {
        int n =arr.size();
        ArrayList<Integer> l1 = new ArrayList<>();
        ArrayList<Integer> l2 = new ArrayList<>();
        for(int i=0;i<n;i++){
            if(arr.get(i)>=0){
                l1.add(arr.get(i));
            }
            else{
                l2.add(arr.get(i));
            }
        }
        int index =0;
        int i=0;
        int j=0;
        while(i<l1.size() && j<l2.size()){
            arr.set(index,l1.get(i));
            index++;
            i++;
            
            arr.set(index,l2.get(j));
            index++;
            j++;
        }
        while(i<l1.size()){
            arr.set(index,l1.get(i));
            index++;
            i++;
        }
        while(j<l2.size()){
            arr.set(index,l2.get(j));
            index++;
            j++;
        }
    }
}
