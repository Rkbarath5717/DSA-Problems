class Solution {
    public int thirdLargest(List<Integer> arr) {
        int n = arr.size();
        if(n<3){
            return -1;
        }
        int first=Integer.MIN_VALUE;
        int second=Integer.MIN_VALUE;
        int third=Integer.MIN_VALUE;
        for(int i=0;i<n;i++){
            if(arr.get(i)>=first){
                third=second;
                second=first;
                first=arr.get(i);
            }
            else if(arr.get(i) >= second && arr.get(i) < first){
                third=second;
                second=arr.get(i);
            }
            else if(arr.get(i) >= third && arr.get(i)<second){
                third=arr.get(i);
            }
        }
         if(third == Integer.MIN_VALUE){
            return -1;
        }
        return third;
    }
}
